# =============================
# 通用设置
# =============================

# 默认使用 LF（Unix 风格换行符）
* text=auto eol=lf

# 保留二进制文件的原始格式
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.rar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.bin binary
*.mp4 binary
*.mov binary
*.avi binary
*.mp3 binary
*.wav binary

# =============================
# Web 前后端
# =============================

# 前端代码统一 LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf

# 后端（Java / Python / Node 等）
*.java text eol=lf
*.py text eol=lf
*.go text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# =============================
# 小程序
# =============================
*.wxml text eol=lf
*.wxss text eol=lf
*.json text eol=lf
*.js text eol=lf

# =============================
# 上位机项目（C/C++/C#/Qt/PyQt）
# =============================
*.cpp text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cs text eol=crlf
*.ui text eol=lf
*.pro text eol=lf

# =============================
# IDE / 工具文件
# =============================
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcproj text eol=crlf
*.filters text eol=crlf
*.user text eol=crlf
*.idea/** text eol=lf
*.iml text eol=lf

# =============================
# 文档
# =============================
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf

# =============================
# Git LFS（可选）
# =============================
# 如果你使用 Git LFS，可以在这里指定大文件类型
# *.mp4 filter=lfs diff=lfs merge=lfs -text
# *.zip filter=lfs diff=lfs merge=lfs -text