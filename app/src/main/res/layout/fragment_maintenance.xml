<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_cz"
                android:layout_width="wrap_content"
                android:text="丢弃所有烤肠重置烤盘"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btn_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="刷新烤盘"
                android:visibility="gone" />
            <Button
                android:id="@+id/btn_logs"
                android:layout_width="wrap_content"
                android:text="查看日志"
                android:layout_marginLeft="20dp"
                android:layout_height="wrap_content"/>
<!--            <Button-->

<!--                android:id="@+id/btn_shijue"-->
<!--                android:text="视觉调试"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_marginLeft="20dp"-->
<!--                android:layout_height="wrap_content"/>-->
            <TextView
                android:id="@+id/tv_erro_status"
                android:layout_width="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="状态：正常"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btn_erro_status"
                android:text="恢复正常状态"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- 嵌套一个垂直布局块 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="20dp">

                <Switch
                    android:id="@+id/sw_kz_algorithm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="烤制算法"
                    android:layout_marginLeft="0dp"
                    android:checked="true"/>

                <Switch
                    android:id="@+id/sw_inspection_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检修模式"
                    android:layout_marginLeft="0dp"
                    android:checked="false"/>

                <TextView
                    android:id="@+id/tvCooldownHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_marginLeft="10dp"
                    android:text="冷却 10 秒"
                    android:textColor="#888888"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_clear_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="  清空烤盘  " />

            <TextView
                android:id="@+id/version_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="15dp"
                android:text="版本号 v-1.2.42"
                android:textColor="#000000"
                android:textSize="18sp" />

        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_kaopan"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="11"
            tools:itemCount="33"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>



    </LinearLayout>
</ScrollView>
