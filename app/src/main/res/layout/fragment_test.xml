<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 动作控制区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="动作控制"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- 执行动作组 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="执行动作组 (200)"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etActionGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnWriteActionGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnReadActionGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="运维模拟正常售卖" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="使用上方 101~133 动作号，走正式出餐+售卖口视觉链路" />

                    <Button
                        android:id="@+id/btnRunFormalSellFromAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="执行" />
                </LinearLayout>

                <!-- 动作组执行结果 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="执行结果 (201)"/>

                    <TextView
                        android:id="@+id/tvActionGroupResult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="未读取"/>

                    <Button
                        android:id="@+id/btnReadActionGroupResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>

                <!-- 烤盘搬移 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="烤盘搬移 (202)"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStartPosition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="起始位置"
                            android:layout_marginLeft="5dp"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEndPosition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:hint="结束位置"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnWriteMovePlate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnReadMovePlate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- 烤盘搬移执行结果 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="搬移结果 (203)"/>

                    <TextView
                        android:id="@+id/tvMovePlateResult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="未读取"/>

                    <Button
                        android:id="@+id/btnReadMovePlateResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>

                <!-- 开关量控制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开关控制 (204)"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSwitchControl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="16位开关状态"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnWriteSwitchControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnReadSwitchControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <!-- 开关控制6	5	4	3	2	1	0
                    3.3V预留	12V预留	照明	冰箱	加热管2	加热管1	加热管0
                    -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开关状态:"
                        android:layout_marginEnd="8dp"/>

                    <CheckBox
                        android:id="@+id/cbHeater0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加热管0"
                        android:layout_marginEnd="4dp"/>

                    <CheckBox
                        android:id="@+id/cbHeater1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加热管1"
                        android:layout_marginEnd="4dp"/>

                    <CheckBox
                        android:id="@+id/cbHeater2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="加热管2"
                        android:layout_marginEnd="4dp"/>

                    <CheckBox
                        android:id="@+id/cbFridge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="冰箱"
                        android:layout_marginEnd="4dp"/>

                    <CheckBox
                        android:id="@+id/cbLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="照明"
                        android:layout_marginEnd="4dp"/>
                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                    </View>
                    <Button
                        android:id="@+id/btnWriteSwitchControlcheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写"
                        android:layout_marginStart="8dp"/>


                    <Button
                        android:id="@+id/btnReadSwitchControlcheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <!-- 行程开关状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="行程开关 (205)"/>

                    <TextView
                        android:id="@+id/tvLimitSwitchStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="未读取"/>

                    <Button
                        android:id="@+id/btnReadLimitSwitchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 温度控制区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="温度控制"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- 烤盘温度读取 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="烤盘温度"/>

                    <TextView
                        android:id="@+id/tvPlateTemp0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="温度0: --"/>

                    <TextView
                        android:id="@+id/tvPlateTemp1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="温度1: --"/>

                    <TextView
                        android:id="@+id/tvPlateTemp2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="温度2: --"/>

                    <Button
                        android:id="@+id/btnReadTemps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>

                <!-- 烤盘温度设置 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="温度设置"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempSet0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="温度0"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempSet1"
                            android:layout_marginLeft="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="温度1"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTempSet2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="温度2"
                            android:inputType="number"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnWriteTemps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写"/>
                    <Button
                        android:id="@+id/btnReadTemps2"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 系统信息区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统信息"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- 版本信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="硬件版本"/>

                    <TextView
                        android:id="@+id/tvHardwareVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="--"/>

                    <Button
                        android:id="@+id/btnReadHardwareVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="固件版本"/>

                    <TextView
                        android:id="@+id/tvFirmwareVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="--"/>

                    <Button
                        android:id="@+id/btnReadFirmwareVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="读"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="自清洁联调"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSelfCleanPosition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="烤盘位 1~33"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnRunPanSelfClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="清洁盘位" />

                    <Button
                        android:id="@+id/btnRunSellPlatformSelfClean"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="清洁出肠台" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelfCleanResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未执行自清洁"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView> 
