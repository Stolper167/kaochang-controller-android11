<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 设备身份只能由本机锁定，禁止通过云备份恢复到另一台物理设备。 -->
        <exclude domain="sharedpref" path="KAOCHANG_APP_CONFIG.xml" />
        <exclude domain="file" path="kaochang_device_identity.json" />
    </cloud-backup>
    <device-transfer>
        <!-- 禁止通过设备迁移复制 deviceCode（云端设备编号）身份副本。 -->
        <exclude domain="sharedpref" path="KAOCHANG_APP_CONFIG.xml" />
        <exclude domain="file" path="kaochang_device_identity.json" />
    </device-transfer>
</data-extraction-rules>
